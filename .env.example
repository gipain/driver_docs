DATABASE_URL=postgres://driver_docs_user:your_password@localhost:5432/driver_docs
DJANGO_DEBUG=True
# Тека bin вашого встановлення GTK3 Runtime for Windows (потрібна для генерації PDF акту).
GTK_RUNTIME_PATH=C:\Program Files\GTK3-Runtime Win64\bin
# Шлях до soffice.exe (LibreOffice) - конвертація ТТН.xlsx у PDF.
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
